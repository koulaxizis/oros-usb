# Kernel and live system
linux-image-amd64
live-boot
live-config
live-config-systemd
systemd-sysv
dbus-user-session
sudo
ca-certificates

# Kiosk session: cage (Wayland) + Chromium in app mode
cage
chromium
chromium-sandbox
# pkill for the session watchdog
procps
libgl1-mesa-dri
libegl1
mesa-vulkan-drivers
fonts-noto-core
fonts-noto-color-emoji

# Tor button: X apps (Tor Browser) inside cage, and what checks and
# unpacks the Tor Browser download (oros-system tor)
xwayland
gpgv
xz-utils

# Network (Wi-Fi from orOS's System button, or nmtui on tty2)
network-manager
wpasupplicant
iw
polkitd

# System button and installer (oros-system)
efibootmgr
dosfstools
# Disks section: NTFS (Windows) when the kernel driver refuses, exFAT tools
ntfs-3g
exfatprogs
# Problem report: which hardware the computer has
pciutils
e2fsprogs
fdisk

# Clock: NTP from Debian's pool servers, time zones, screen brightness
systemd-timesyncd
tzdata
brightnessctl

# Printing without vendor drivers: CUPS finds IPP Everywhere and AirPrint
# printers on the network (cups-browsed, Avahi) and on USB (ipp-usb).
cups
cups-client
cups-browsed
cups-filters
ipp-usb
ghostscript
avahi-daemon
libnss-mdns

# Bluetooth: headphones and speakers (PipeWire), mice and keyboards
bluez
libspa-0.2-bluetooth
bluez-firmware

# Boot splash
plymouth
plymouth-themes
# Text on the boot screen: the passphrase prompt of encrypted data
plymouth-label

# Encrypted data (optional, LUKS2): cryptsetup in the system and in the
# initramfs, where oros-unlock asks for the passphrase on the boot screen
cryptsetup
cryptsetup-initramfs
dmsetup

# Sound
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
# orOS Bridge (plugins and the sound card for Studio) reaches PipeWire as a
# PulseAudio client, or through ALSA
libpulse0
# Sound card profiles; without them most laptops show no output at all.
alsa-ucm-conf
alsa-topology-conf

# Firmware for common Wi-Fi, graphics and sound hardware
firmware-linux-free
firmware-linux-nonfree
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-brcm80211
firmware-intel-sound
firmware-sof-signed
amd64-microcode
intel-microcode
