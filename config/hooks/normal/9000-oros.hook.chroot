#!/bin/sh
# The kiosk user. live-config would need the user-setup package to make
# it at boot; creating it in the image is simpler and always there.
if ! id oros >/dev/null 2>&1; then
	useradd --create-home --shell /bin/bash --comment "orOS" oros
	passwd --lock oros
fi
for g in audio video input render netdev plugdev systemd-journal bluetooth; do
	if getent group "$g" >/dev/null; then usermod -aG "$g" oros; fi
done

# Power button shuts down cleanly; lid close suspends.
set -e
mkdir -p /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/oros.conf <<'EOF'
[Login]
HandlePowerKey=poweroff
HandleLidSwitch=suspend
EOF
# The launcher and the system bridge must be executable even if they were
# copied without the bit; sudo ignores rule files with loose permissions.
chmod 0755 /opt/oros/oros-portable /opt/oros/oros-system /opt/oros/oros-bridge /usr/local/bin/oros-kiosk
chmod 0440 /etc/sudoers.d/oros-install
systemctl enable oros-selftest.service oros-selftest-files.service oros-journal.service oros-time.service oros-bluetooth.service
# The system log lives in /home, which orOS keeps (oros-journal.service).
rm -rf /var/log/journal
ln -s /home/.oros-journal /var/log/journal

# orOS boot screen (Plymouth, start and shut down): the logo and three
# breathing dots from scripts/boot-art.py on orOS's own background, the
# colour Chromium shows before orOS paints. From Debian's spinner theme
# only the images of a password prompt, never its spinner.
for f in bullet capslock entry keyboard keymap-render lock; do
	if [ -f "/usr/share/plymouth/themes/spinner/$f.png" ]; then
		cp -n "/usr/share/plymouth/themes/spinner/$f.png" /usr/share/plymouth/themes/oros/
	fi
done
plymouth-set-default-theme -R oros

# orOS runs as a system service on tty1 (oros-session.service), the way a
# display manager does, so the boot screen stays until it takes over and
# no login text shows in between. tty2 keeps its autologin to the network
# screen (Ctrl+Alt+F2).
systemctl enable oros-session.service
systemctl set-default graphical.target
