# Boot tests only: when the test put /home/.oros-selftest on the persistence
# partition, save a network the way the System button does (as the orOS
# user), so the test can check that it lands in /home/.oros-network, and
# set the time zone the same way (/home/.oros-timezone). It also notes
# whether the print server runs and the Bluetooth pairings folder is in
# place (~/.oros-selftest-devices).
[Unit]
Description=orOS boot self-test
ConditionPathExists=/home/.oros-selftest
After=NetworkManager.service cups.service oros-bluetooth.service
Wants=NetworkManager.service

[Service]
Type=oneshot
User=oros
ExecStart=/usr/bin/nmcli connection add type ethernet ifname "*" con-name oros-selftest autoconnect no
ExecStart=/usr/bin/sudo -n /opt/oros/oros-system time --zone Europe/Athens
ExecStart=/bin/sh -c '{ lpstat -r; findmnt -n -o TARGET /var/lib/bluetooth; } > "$$HOME/.oros-selftest-devices" 2>&1' 

[Install]
WantedBy=multi-user.target
