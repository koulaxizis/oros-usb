# The System button may run the orOS installer (it asks before erasing).
oros ALL=(root) NOPASSWD: /opt/oros/oros-system install *
# ...and the system update (only the official release; it keeps the data).
oros ALL=(root) NOPASSWD: /opt/oros/oros-system update *
# ...and open other disks from the Disks section and Files (only those it lists;
# Windows disks read-only).
oros ALL=(root) NOPASSWD: /opt/oros/oros-system mount *
# ...and set the time zone (only a zone from /usr/share/zoneinfo).
oros ALL=(root) NOPASSWD: /opt/oros/oros-system time --zone *
# ...and make the folder for encrypted users on the data partition (owned by
# oros, closed to others; nothing else is changed).
oros ALL=(root) NOPASSWD: /opt/oros/oros-system vault-base
# ...and NVIDIA's driver (only the official release's pack for this system,
# for a card it supports; nvidia.go), or take it away again.
oros ALL=(root) NOPASSWD: /opt/oros/oros-system nvidia --install
oros ALL=(root) NOPASSWD: /opt/oros/oros-system nvidia --remove
