#!/bin/sh
# Runs orOS full screen on tty1: cage (a kiosk Wayland compositor) shows only
# the browser that the orOS Portable launcher opens. If the window is
# closed, orOS starts again; the power button shuts the machine down.
set -u

ROOT="$HOME/oros"
mkdir -p "$ROOT/data"

# The image carries orOS in /opt/oros/app (read-only). ~/oros/app links
# to it; "oros-portable update" replaces the link with a newer copy on the
# persistence partition. A new image resets the link (copying thousands of
# files to the stick made the first start very slow).
IMAGE_BUILD="$(cat /opt/oros/app/.oros-build 2>/dev/null)"
if [ ! -f "$ROOT/app/index.html" ] || [ "$IMAGE_BUILD" != "$(cat "$ROOT/.image-build" 2>/dev/null)" ]; then
	rm -rf "$ROOT/app" "$ROOT/app.old" "$ROOT/app.new"
	ln -s /opt/oros/app "$ROOT/app"
	echo "$IMAGE_BUILD" > "$ROOT/.image-build"
fi

export LANG=C.UTF-8
export OROS_PORTABLE_ROOT="$ROOT"
export OROS_PORTABLE_BROWSER=/usr/bin/chromium
# The orOS system extension adds the System button (Wi-Fi, sound, power,
# install); Chromium keeps a dark window until orOS paints.
export OROS_PORTABLE_BROWSER_ARGS="--ozone-platform=wayland --start-fullscreen --disable-features=Translate --load-extension=/opt/oros/system-ext --default-background-color=ff1b1a18"
export XKB_DEFAULT_LAYOUT="us,gr"
export XKB_DEFAULT_OPTIONS="grp:alt_shift_toggle"
# Virtual machines and some old GPUs have no hardware GL.
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1

while true; do
	# -s lets Ctrl+Alt+F2 switch to the network screen.
	cage -s -- /opt/oros/oros-portable
	sleep 1
done
