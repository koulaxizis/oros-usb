#!/bin/sh
# Picks the orOS that ~/oros/app serves (oros-session, every start).
#   oros-app-link ROOT IMAGE_APP
# The image carries orOS in IMAGE_APP (/opt/oros/app, read-only). ROOT/app
# links to it until the launcher downloads a newer orOS onto the
# persistence partition (oros-portable autoupdate.go: every 6 hours with
# a persistence partition, swapped in at the next start; or System ›
# Update orOS). A new image (system update or a new stick) used to reset
# the link always, which put an older orOS back when the downloaded one
# was newer (Chris 2026-11-28); now the newer of the two stays. With the
# same version the image's wins: it is tested with this system and needs
# no copy on the stick (copying thousands of files there made the first
# start very slow).
set -u
ROOT="$1"
IMAGE="$2"

appver() {
	sed -n 's/.*APP_VERSION *= *"\([0-9][0-9.]*\)".*/\1/p' "$1/shell.js" 2>/dev/null | head -n 1
}

# newer A B: version A is higher than version B (dotted numbers).
newer() {
	[ -n "$1" ] || return 1
	[ -n "$2" ] || return 0
	[ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -n 1)" = "$1" ]
}

use_image() {
	rm -rf "$ROOT/app" "$ROOT/app.old" "$ROOT/app.new"
	ln -s "$IMAGE" "$ROOT/app"
}

BUILD="$(cat "$IMAGE/.oros-build" 2>/dev/null)"
if [ ! -f "$ROOT/app/index.html" ]; then
	use_image
elif [ "$BUILD" != "$(cat "$ROOT/.image-build" 2>/dev/null)" ]; then
	if [ -L "$ROOT/app" ] || ! newer "$(appver "$ROOT/app")" "$(appver "$IMAGE")"; then
		use_image
	else
		echo "== $(date -Is) new image $BUILD: kept the downloaded orOS $(appver "$ROOT/app") (image has $(appver "$IMAGE"))" >> "$ROOT/data/session.log"
		rm -rf "$ROOT/app.old" "$ROOT/app.new"
	fi
fi
echo "$BUILD" > "$ROOT/.image-build"
