[Plymouth Theme]
Name=orOS
Description=orOS logo while the computer starts
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/oros
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x1b1a18
BackgroundEndColor=0x1b1a18
