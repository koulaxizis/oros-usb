{
  "manifest_version": 3,
  "name": "orOS system",
  "version": "0.1.0",
  "description": "Wi-Fi, sound, battery, power and install for orOS USB.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:47800/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
